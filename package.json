{
  "name": "dsh-mcp-manager",
  "version": "0.2.0",
  "private": true,
  "description": "轻量级 MCP 服务管理器：查看/启停/增删/导入导出/握手探针，管理 DeepSeek Harness 已接入与本机其它客户端的 MCP 服务。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "mcp",
    "mcp-manager",
    "mcp-inventory",
    "mcp-probe"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "author": "gainaixiaobing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gainaixiaobing/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/gainaixiaobing/dsh-mcp-manager#readme",
  "bugs": {
    "url": "https://github.com/gainaixiaobing/dsh-mcp-manager/issues"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs test/client.test.mjs"
  }
}
